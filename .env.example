# ─────────────────────────────────────────────────────────────
# Landing exímIA Academy v2 · variáveis de ambiente
# Nenhuma delas é obrigatória para a página subir. Cada ausência
# degrada de forma explícita, nunca em falso sucesso.
# ─────────────────────────────────────────────────────────────

# Origem canônica do site. Alimenta metadata, canonical, sitemap,
# robots e a imagem OG.
# Vazia, ausente ou inválida cai em https://eximiaacademy.com.br.
NEXT_PUBLIC_SITE_URL=https://eximiaacademy.com.br

# Destino do lead enviado em `#contato` (rota /api/contato).
# Recebe POST { data: { ...campos, source, submittedAt } }.
# SEM esta variável o formulário não finge sucesso: o visitante cai
# no canal direto por email com os campos já preenchidos.
CONTACT_ENDPOINT=

# Medição de audiência (PostHog). SEM a chave, zero requisição de
# analytics sai da página e `track()` vira no-op absoluto.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
